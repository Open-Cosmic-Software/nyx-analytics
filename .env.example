# ── Tacilytics configuration — copy to .env and fill in ──
# Port (bound to 127.0.0.1; put a reverse proxy / TLS in front)
PORT=3920

# Dashboard passphrase (plaintext; keep .env at chmod 600).
# Only used until you create the first account in Settings → Security (then it stops working).
WEB_PASSWORD=change-me-to-a-strong-passphrase

# Public URL of the dashboard. Pins the passkey domain (recommended behind a reverse proxy).
# TACILYTICS_ORIGIN=https://analytics.example.com
# Reverse proxies in front (default 1). 0 = no proxy, the socket address is used for rate limits.
# TRUST_PROXY=1

# Secret for signing session tokens — long random string
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=change-me

# Salt for the daily one-way visitor hash (rotate to reset all visitor identities)
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INGEST_SALT=change-me

# SQLite database path
DB_PATH=./data/analytics.db

# API key for agents / CLI (Bearer token) — generate a long random string
API_KEY=change-me

# Data minimisation: auto-purge raw events older than N days (0 = keep forever)
DATA_RETENTION_DAYS=0

# Weekly report by e-mail (optional). smtps://…:465 or smtp://…:587 (STARTTLS)
# SMTP_URL=smtps://user:password@mail.example.com:465
# REPORT_FROM=Tacilytics <reports@example.com>
# REPORT_HOUR_UTC=6
