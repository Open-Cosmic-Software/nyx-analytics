{
  "name": "tacilytics",
  "version": "2.0.2",
  "description": "Privacy-first, cookieless analytics for websites and apps. Self-hosted: one Node process, one SQLite file.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "cli": "node cli.js",
    "test": "node --test test/*.test.js"
  },
  "author": "Nyx 🦞 & Fabian Budde",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "express": "^4.21.2"
  },
  "bin": {
    "tacilytics": "cli.js",
    "nyx": "cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Open-Cosmic-Software/tacilytics.git"
  },
  "homepage": "https://github.com/Open-Cosmic-Software/tacilytics#readme",
  "keywords": [
    "analytics",
    "privacy",
    "cookieless",
    "gdpr",
    "self-hosted",
    "web-analytics",
    "sqlite",
    "plausible-alternative",
    "flutter",
    "app-analytics"
  ],
  "bugs": {
    "url": "https://github.com/Open-Cosmic-Software/tacilytics/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "server.js",
    "cli.js",
    "day-salt.js",
    "tz-country.js",
    "public/",
    "sdk/flutter/",
    "!sdk/flutter/.dart_tool/",
    "!sdk/flutter/build/",
    ".env.example",
    "LICENSE",
    "README.md"
  ]
}
